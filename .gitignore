# 1. Dependency directories (Thư mục thư viện - nếu sau này bạn dùng npm/yarn/Vite)
node_modules/
jspm_packages/
.npm/

# 2. Build outputs (Các file sinh ra sau khi đóng gói web)
dist/
tmp/
out/
build/
.next/

# 3. Logs (File ghi nhật ký lỗi hệ thống)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. OS Files (File rác tự sinh của hệ điều hành, cực kỳ nên chặn)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# 5. IDEs/Editors (File cấu hình riêng của các trình code như VS Code, Eclipse)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# 6. Secrets/Environment Variables (QUAN TRỌNG: Chặn các file chứa mật khẩu, key API)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem